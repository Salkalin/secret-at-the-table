generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HOST
}

model User {
  id        String        @id @default(cuid())
  email     String        @unique
  password  String
  role      Role
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  sessions  GameSession[]
}

model GameSession {
  id        String    @id @default(cuid())
  code      String    @unique
  hostId    String
  scenario  String
  state     Json
  status    String    @default("lobby")
  createdAt DateTime  @default(now())
  endedAt   DateTime?

  host    User     @relation(fields: [hostId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  players Player[]
  teams   Team[]
  logs    GameLog[]

  @@index([code])
}

model Player {
  id        String   @id @default(cuid())
  sessionId String
  nickname  String
  socketId  String?
  teamId    String?
  isCaptain Boolean  @default(false)
  joinedAt  DateTime @default(now())

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  team    Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull, onUpdate: Cascade)
}

model Team {
  id        String   @id @default(cuid())
  sessionId String
  name      String
  score     Int      @default(0)

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  players Player[]
  votes   Vote[]
}

model Vote {
  id        String   @id @default(cuid())
  teamId    String
  round     Int
  suspectId String
  correct   Boolean?
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model GameLog {
  id        String   @id @default(cuid())
  sessionId String
  code      String
  level     String   @default("info")
  event     String
  actor     String?
  payload   Json?
  createdAt DateTime @default(now())

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([sessionId])
  @@index([code])
  @@index([createdAt])
  @@index([event])
}